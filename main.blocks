ch" functionid="*U[Lyg/D*bbMQ[G:(naC"></mutation><field name="function_name">triggerChestLaunch</field><statement name="STACK"><block type="variables_set" id=")gV16z(]NiEAU:~j3KdV"><field name="VAR" id="]IQo][/]ufb^XKg21qT9">introductionTriggered</field><value name="VALUE"><shadow type="math_number" id="u8nNFJt#|5[[a^965z.x"><field name="NUM">0</field></shadow><block type="logic_boolean" id="v?8pf#t)]J+ZW3Y1uWP2"><field name="BOOL">TRUE</field></block></value><next><block type="minecraftSay" id="k=Ozuf5V5[889$`=9)Ij"><value name="message"><shadow type="text" id="eZKJT:pH=ya]~iM39p|^"><field name="TEXT">�� *WHACK!* The chest breaks open and rockets into the sky!</field></shadow></value><next><block type="minecraftExecute" id="D^u]R#Ja-|{!.*a`5%Qq"><value name="command"><shadow type="text" id="C]D]l/{~qFTsk97O@)}O"><field name="TEXT">playsound ambient.weather.thunder @a</field></shadow></value><next><block type="minecraftAgentMove" id="QtJa#s3w=495FAi)z66t"><value name="direction"><shadow type="minecraftAgentSixDirection" id=")NC,zq%ed4-b9G!wuC2s"><field name="direction">SixDirection.Down</field></shadow></value><value name="blocks"><shadow type="math_number" id="_gNE7F%a%$0uyt;6JSb1"><field name="NUM">1</field></shadow></value><next><block type="device_pause" id=".`tXwp*?K.Sn4iYZb@D+"><value name="pause"><shadow type="math_number" id="/l~?j;uUQ~e,T@[VvB3)"><field name="NUM">1200</field></shadow></value><next><block type="function_call" id="d,_|~+ZUd,WpQ#^ZvL+e"><mutation name="agentIntroductionSpeech" functionid="b!;H#!cYA*?1Q.[EY:[y"></mutation></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="[h{)L|byO^h#Ef+GA3X," x="1544" y="893"><mutation name="agentIntroductionSpeech" functionid="b!;H#!cYA*?1Q.[EY:[y"></mutation><field name="function_name">agentIntroductionSpeech</field><statement name="STACK"><block type="minecraftSay" id="iXC7o:PRUr_iTAMH)Jwv"><value name="message"><shadow type="text" id="(Yso2yrTWo0O)mxrYHMi"><field name="TEXT">�� Agent: "System reboot... 100% complete."</field></shadow></value><next><block type="device_pause" id="ETqL@f.w,.nI2T$z}Pa2"><value name="pause"><shadow type="math_number" id="z]iu~a?bX[$@5xjAAi$7"><field name="NUM">2000</field></shadow></value><next><block type="minecraftSay" id="Z7N4#^6+=7l/wkv]91^b"><value name="message"><shadow type="text" id="L]CRlHni_[dXls/_Uc;+"><field name="TEXT">�� Agent: "Greetings, Creator. Thank you for freeing me from that confinement matrix."</field></shadow></value><next><block type="device_pause" id=")B{Lvn#ELkCigT=0.L$l"><value name="pause"><shadow type="math_number" id="UeYz|~qH3q94r3tIZD`h"><field name="NUM">2500</field></shadow></value><next><block type="minecraftSay" id="3aDfmA|m#LKn@3#6l{rT"><value name="message"><shadow type="text" id="5XK8uk/s4.H*R=?NGZan"><field name="TEXT">�� Agent: "I am your autonomous AI Assistant. Voice matrix and material distribution protocols are now fully active."</field></shadow></value><next><block type="variables_set" id="fp3AF%;YM=Ks[jt(x8Fc"><field name="VAR" id="09:WYJWq1bva-*!aFX}d">assistantActive</field><value name="VALUE"><shadow type="math_number" id="@e#uD}Lu`UKt!oXUOHlW"><field name="NUM">0</field></shadow><block type="logic_boolean" id="#;bDc?n1Pifwj6r3/cfz"><field name="BOOL">TRUE</field></block></value><next><block type="function_call" id="?;vO|.d5_PKpriK_u;aC"><mutation name="startAIEngineLoops" functionid="T,8k-#n27t$d@R@7.N@r"></mutation></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="MNR}B4}zlV4;~d4!kL@}" x="2169" y="893"><mutation name="startAIEngineLoops" functionid="T,8k-#n27t$d@R@7.N@r"></mutation><field name="function_name">startAIEngineLoops</field><statement name="STACK"><block type="typescript_statement" id="rx,|65{crQHVM`|%$ux4"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="loops.forever(function () {" line1="                                                                                                                                                                                                                                                                                                                                    if (assistantActive) {" line2="                                                                                                                                                                                                                                                                                                                                                let playerPos = player.position();" line3="                                                                                                                                                                                                                                                                                                                                                            let agentPos = agent.getPosition();" line4="                                                                                                                                                                                                                                                                                                                                                                        let distance = Math.sqrt(Math.pow(agentPos.getValue(Axis.X) - playerPos.getValue(Axis.X), 2) + Math.pow(agentPos.getValue(Axis.Y) - playerPos.getValue(Axis.Y), 2) + Math.pow(agentPos.getValue(Axis.Z) - playerPos.getValue(Axis.Z), 2));" line5="                                                                                                                                                                                                                                                                                                                                                                        " line6="                                                                                                                                                                                                                                                                                                                                                                                    " line7="                                                                                                                                                                                                                                                                                                                                                                                                if (distance &gt; 10) {" line8="                                                                                                                                                                                                                                                                                                                                                                                                                agent.teleportToPlayer();" line9="                                                                                                                                                                                                                                                                                                                                                                                                                            } else if (distance &gt; 3) {" line10="                                                                                                                                                                                                                                                                                                                                                                                                                                            agent.turn(TurnDirection.Left); " line11="                                                                                                                                                                                                                                                                                                                                                                                                                                                            agent.move(SixDirection.Forward, 1);" line12="                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }" line13="                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }" line14="                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        loops.pause(400); " line15="                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            });" numlines="16"></mutation></block></statement></block></xml>