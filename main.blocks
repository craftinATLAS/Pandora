type="minecraftCreatePosition" id="Dgi%5n7BR@000#a`2o#i"></shadow></value><value name="p2"><shadow type="minecraftCreatePosition" id="?K(}qkY*:ib^+%{8[b|["><value name="x"><shadow type="math_number" id="Mcm8%3]^EfpgHD0c$BG-"><field name="NUM">0</field></shadow></value><value name="y"><shadow type="math_number" id="cE!|krHFYP0KWt+0~R,p"><field name="NUM">0</field></shadow></value><value name="z"><shadow type="math_number" id="Wl3.ql|(WF.OTWX?y/1a"><field name="NUM">5</field></shadow></value></shadow></value></block></value><next><block type="minecraftAgentTeleportPos" id="/i@Z]?Ixq{`N(O/q1O91"><comment pinned="false" h="80" w="160">Position the agent at the core location</comment><value name="pos"><shadow type="minecraftCreatePosition" id="l%B@Y#Ieup4-[z+Y)gW1"></shadow></value><value name="dir"><shadow type="minecraftAgentCompassDirection" id="fQQF+zsoC6~QaR04`=Mi"><field name="direction">CompassDirection.West</field></shadow></value><next><block type="minecraftExecute" id="*(e`7v2GMFLq(38,Z#{$"><comment pinned="false" h="80" w="160">Spawn the Custom Living Chest with exactly 3 health points (1.5 Hearts)</comment><value name="command"><block type="typescript_expression" id=")3@y_P]V[-+,K~*M/(lR"><field name="EXPRESSION">`summon armor_stand ${spawnPos.getValue(Axis.X)} ${spawnPos.getValue(Axis.Y)} ${spawnPos.getValue(Axis.Z)} {CustomName:"\\"Living Chest\\"",CustomNameVisible:1b,Health:3f,Attributes:[{Name:"generic.max_health",Base:3.0}]}`</field></block></value><next><block type="minecraftExecute" id=".{S0nh,=4-|o],WQTCh2"><value name="command"><shadow type="text" id=";X`m[)(QT4c:WKH=h2l:"><field name="TEXT">replaceitem entity @e[type=armor_stand,name="Living Chest",c=1] slot.armor.head 0 chest</field></shadow></value><next><block type="minecraftSay" id="At7fh9LMe*p9i_OM_@[%"><value name="message"><shadow type="text" id="_}!gMh/V)ZcR)qTN%7i]"><field name="TEXT">⚠️ You hear a strange mechanical breathing sound from a chest ahead...</field></shadow></value><next><block type="typescript_statement" id="#gLCpEKFT^yC4)m5#7a["><mutation xmlns="http://www.w3.org/1999/xhtml" line0="loops.forever(function () {" line1="                                                                                                                    if (!introductionTriggered) {" line2="                                                                                                                                player.execute(`particle minecraft:basic_smoke_particle ${spawnPos.getValue(Axis.X)} ${spawnPos.getValue(Axis.Y) + 1} ${spawnPos.getValue(Axis.Z)}`);" line3="                                                                                                                                            // Robot inside wiggles to escape" line4="                                                                                                                                                        agent.turn(TurnDirection.Left);" line5="                                                                                                                                                                    agent.turn(TurnDirection.Right);" line6="                                                                                                                                                                            }" line7="                                                                                                                                                                                    loops.pause(1500); " line8="                                                                                                                                                                                        });" numlines="9"></mutation></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="minecraftOnChat" id="dAxrUk:~[-%NpLg}ltKq" x="3294" y="0"><mutation xmlns="http://www.